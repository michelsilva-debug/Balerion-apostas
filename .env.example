# Copie para .env e preencha com seus valores reais (NUNCA comite o .env)

# Token do bot do Telegram (gerado pelo @BotFather)
TELEGRAM_TOKEN=

# ID do chat/canal de destino das mensagens
TELEGRAM_CHAT=

# Chave da API-Football (api-sports.io)
APIFOOTBALL_KEY=

# Opcional: diretorio para o estado persistente.
# No Railway, monte um volume e use DATA_DIR=/data para nao perder
# budget/cache/log/aprendizado a cada deploy. Local: deixe em branco (usa a pasta atual).
DATA_DIR=

# Opcional: enviar mensagem de boot no Telegram a cada inicio (1 = sim, 0 = nao).
NOTIFY_BOOT=1
